{
  "openapi": "3.0.0",
  "info": {
    "title": "GDG Event Management & Registration API",
    "version": "1.0.0",
    "description": "API documentation for the GDG Club Event Management and Registration platform."
  },
  "servers": [
    {
      "url": "/api",
      "description": "API Base URL"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "responses": {
          "200": { "description": "Server is operational" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "example": "Jane Doe" },
                  "email": { "type": "string", "example": "jane@gdg.com" },
                  "password": { "type": "string", "example": "SecurePass123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "409": { "description": "Email already exists" },
          "422": { "description": "Validation error" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user and issue JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "jane@gdg.com" },
                  "password": { "type": "string", "example": "SecurePass123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" },
          "422": { "description": "Validation error" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get current authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile returned" },
          "401": { "description": "Unauthorized or invalid token" }
        }
      }
    },
    "/users/me/registrations": {
      "get": {
        "tags": ["Users"],
        "summary": "Get current user registrations (upcoming first, then past)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of user registrations with full event details" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/events": {
      "get": {
        "tags": ["Events"],
        "summary": "List events with search, filters, and pagination",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Keyword search across title, description, venue" },
          { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Filter by exact category" },
          { "name": "from", "in": "query", "schema": { "type": "string" }, "description": "Filter from ISO date" },
          { "name": "to", "in": "query", "schema": { "type": "string" }, "description": "Filter to ISO date" },
          { "name": "upcoming", "in": "query", "schema": { "type": "string", "enum": ["true", "false"] }, "description": "Filter upcoming events only" },
          { "name": "sort", "in": "query", "schema": { "type": "string" }, "description": "Sorting order e.g. dateTime:asc" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Paginated events with seatsLeft and metadata" }
        }
      },
      "post": {
        "tags": ["Events"],
        "summary": "Create new event (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "description", "dateTime", "venue", "capacity", "category"],
                "properties": {
                  "title": { "type": "string", "example": "AI & Cloud Summit" },
                  "description": { "type": "string", "example": "Comprehensive deep-dive into modern cloud technologies." },
                  "dateTime": { "type": "string", "example": "2026-11-20T10:00:00Z" },
                  "venue": { "type": "string", "example": "Campus Auditorium" },
                  "capacity": { "type": "integer", "example": 100 },
                  "category": { "type": "string", "example": "Tech" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Event created successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - requires ADMIN role" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/events/categories": {
      "get": {
        "tags": ["Events"],
        "summary": "List distinct event categories",
        "responses": {
          "200": { "description": "List of categories" }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "tags": ["Events"],
        "summary": "Get event details by ID (supports optional authentication)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event details with seatsLeft and optional isRegistered status" },
          "404": { "description": "Event not found" }
        }
      },
      "put": {
        "tags": ["Events"],
        "summary": "Update event (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "dateTime": { "type": "string" },
                  "venue": { "type": "string" },
                  "capacity": { "type": "integer" },
                  "category": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Event updated" },
          "404": { "description": "Event not found" },
          "409": { "description": "Capacity below current registrations" }
        }
      },
      "delete": {
        "tags": ["Events"],
        "summary": "Delete event (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Event deleted" },
          "404": { "description": "Event not found" }
        }
      }
    },
    "/events/{id}/register": {
      "post": {
        "tags": ["Registrations"],
        "summary": "Register current authenticated user for event (concurrency safe)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": { "description": "Registration successful" },
          "400": { "description": "Event already started" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Event not found" },
          "409": { "description": "Event is full or user already registered" }
        }
      },
      "delete": {
        "tags": ["Registrations"],
        "summary": "Unregister current user from event",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Successfully unregistered" },
          "400": { "description": "Cannot unregister from past event" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not registered for event" }
        }
      }
    },
    "/events/{id}/registrations": {
      "get": {
        "tags": ["Registrations"],
        "summary": "Get list of registered attendees (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of attendees" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - requires ADMIN role" },
          "404": { "description": "Event not found" }
        }
      }
    }
  }
}
